{
  "description": "Injecteert de PA-persona en wegwijzer, en bootstrapt personal/memory/config bij eerste gebruik.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
